{
  "name": "wallet-ledger-api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "node scripts/migrate.cjs",
    "db:seed": "node scripts/seed.cjs",
    "db:explain": "node scripts/explain.cjs",
    "db:reconcile": "node scripts/reconcile.cjs",
    "test": "pnpm build && node --test test/*.test.cjs",
    "load": "node scripts/load.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "~5.9.3",
    "undici": "^7.30.2"
  }
}
